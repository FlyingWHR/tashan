# Cloudflare Pages headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# fonts never change → cache hard
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# code + data change during iteration → always revalidate (zone may cap TTL; assets are versioned too)
/css/*
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache

# embeddable badges — refresh hourly (GitHub's camo proxy caches longer anyway)
/badge/*
  Cache-Control: public, max-age=3600
