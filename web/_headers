# Cloudflare Pages headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# fonts never change → cache hard
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# code + data change during iteration → always revalidate (zone may cap TTL; assets are versioned too)
/css/*
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache

# the subregistry endpoint — an agent expects JSON, and an extensionless file would otherwise be
# served as octet-stream. Long-cached at the edge but revalidated: it changes once per pipeline run.
/v0.1/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900, stale-while-revalidate=86400

# embeddable badges — now rendered by functions/badge/, which sets its own Content-Type and
# Cache-Control per response (a 404 for an unranked capability must NOT be cached for an hour the way
# a real badge is). _headers does not apply to Function responses, so this rule is kept only as the
# documented intent for the route; the Function is the authority.
/badge/*
  Cache-Control: public, max-age=3600

# the plain-markdown dossier — an answer engine that will not run JS gets the same facts as the page,
# without parsing around the chrome. Extensionless-adjacent: .md would otherwise download, not render.
/capability/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900, stale-while-revalidate=86400

# THE HUBS GOT THE SAME TIER. /capability/*.md answered "what is this thing"; these answer "what
# should I use for X" and "what does this job install", which are the questions actually asked of an
# answer engine. They shipped for weeks with no markdown twin while every individual capability had
# one — the easy tier was covered and the high-intent one was not.
/category/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900, stale-while-revalidate=86400
/task/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900, stale-while-revalidate=86400
/role/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900, stale-while-revalidate=86400
